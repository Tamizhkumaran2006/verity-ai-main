# ==========================================
# AI Service Environment Configuration
# ==========================================

# API Security (must match Node.js backend)
AI_SERVICE_API_KEY=verity_ai_internal_secret_key_2024

# OCR Provider: "tesseract" | "easyocr" | "auto"
OCR_PROVIDER=auto

# Tesseract binary path (Windows example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: usually /usr/bin/tesseract (auto-detected)

# Optional: LLM for smarter parsing
# LLM_PROVIDER=openai   # "openai" | "gemini"
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Poppler path for PDF rendering (Windows)
# POPPLER_PATH=C:\poppler\bin

# Logging
LOG_LEVEL=INFO
