# ==========================================
# Verity AI - Bank Loan Verification System
# Environment Configuration Template
# ==========================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/verity_ai
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/verity_ai

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_64_chars
JWT_EXPIRES_IN=7d

# --- Firebase Admin SDK ---
# Download serviceAccountKey.json from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# --- Python AI Service ---
PYTHON_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=verity_ai_internal_secret_key_2024

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff

# --- Google Cloud Storage (optional, for production) ---
# GCS_BUCKET_NAME=verity-ai-documents
# GCS_KEY_FILE=./gcs-key.json

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
